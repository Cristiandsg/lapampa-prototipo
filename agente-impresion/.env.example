# Configuración del agente de impresión (HU16). Copia este archivo como .env en esta
# misma carpeta y llena los valores. El .env no se sube a GitHub.

# Dirección de la API, terminada en /api
API_URL=https://lapampa-api.onrender.com/api

# La misma clave que CLAVE_AGENTE_IMPRESION en Render (mínimo 16 caracteres)
CLAVE_AGENTE=

# A dónde sale cada impresora. Tres formas:
#   \\localhost\Cocina        impresora compartida de Windows (nombre de recurso compartido sin espacios)
#   tcp://192.168.1.50:9100   impresora térmica de red (puerto 9100)
#   archivo:./tirillas        modo prueba: guarda cada tirilla en un archivo de texto
# Si se deja vacía, este agente no atiende esa impresora.
IMPRESORA_COCINA=archivo:./tirillas
IMPRESORA_CAJA=archivo:./tirillas

# Tabla de caracteres de la impresora para las tildes y la ñ:
#   cp1252  (ESC t 16)  la mayoría de Epson y compatibles
#   cp850   (ESC t 2)   muchas impresoras genéricas de 58 mm
CODIFICACION=cp1252

# Cada cuánto consulta la cola (milisegundos)
INTERVALO_MS=3000
