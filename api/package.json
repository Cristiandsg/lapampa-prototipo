{
  "name": "lapampa-api",
  "version": "0.0.1",
  "private": true,
  "description": "API REST (Node.js + Express, patrón MVC) del prototipo de La Pampa Gastrobar",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
