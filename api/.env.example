# Copiar este archivo como .env y poner los valores reales (el .env NO se sube a GitHub)
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lapampa

# Sesión (JWT): usar una cadena larga y aleatoria
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=12h

# Origen permitido para el frontend (en desarrollo, Vite)
CORS_ORIGEN=http://localhost:5173
