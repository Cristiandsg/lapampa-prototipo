# Copiar este archivo como .env y poner los valores reales (el .env NO se sube a GitHub)
PORT=3000

# Base de datos MySQL
# Con XAMPP: usuario root y contraseña vacía
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lapampa
# Solo en la nube (Aiven): DB_SSL=true y DB_SSL_CA con el certificado. En local se dejan vacíos.
DB_SSL=
DB_SSL_CA=

# Sesión (JWT): usar una cadena larga y aleatoria
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=12h

# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGEN=http://localhost:5173

# Domicilios (HU09). Si se dejan vacíos se usan los valores que confirmó el propietario.
VALOR_ENVIO=7000
WHATSAPP_LOCAL=3195654739
TRANSFERENCIA_BANCO=Bancolombia
TRANSFERENCIA_TIPO=Cuenta de ahorros
TRANSFERENCIA_NUMERO=80819808345
TRANSFERENCIA_TITULAR=
# Pedidos del formulario público por dispositivo en una hora
LIMITE_PEDIDOS_HORA=5
