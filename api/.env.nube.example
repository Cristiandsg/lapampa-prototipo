# Copiar como api/.env.nube (NO se sube a GitHub) para crear la base de la nube con:
#   npm run db:nube --prefix api
# Los datos salen de la consola de Aiven: servicio MySQL > Overview > Connection information.
DB_HOST=mysql-lapampa-xxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=pegar-aqui-la-contraseña-de-aiven
DB_NAME=lapampa
DB_SSL=true
# Pegar el "CA certificate" en UNA sola línea, con \n donde van los saltos de línea.
# Si se deja vacío también conecta con SSL, usando los certificados del sistema.
DB_SSL_CA=
